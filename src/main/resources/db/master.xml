<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <changeSet author="john.doe" id="create.table.client_api_keys">
        <createTable tableName="client_api_keys">
            <column autoIncrement="true" name="id" type="bigint">
                <constraints primaryKey="true" primaryKeyName="pk_client_api_key_id"/>
            </column>
            <column name="api_key" type="varchar">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uq_client_api_key"/>
            </column>
            <column name="revoked" type="boolean" defaultValueBoolean="false"/>
            <column name="created_at" type="timestamp" defaultValueComputed="now()"/>
        </createTable>
    </changeSet>
    <changeSet author="unknown" id="default_client_api_keys">
        <insert tableName="client_api_keys">
            <column name="api_key" value="M2ZjNDZmOWItMzJmMC00YzhlLWE3ZTctNDY3YzQ2YzAzZjli"/>
        </insert>
        <insert tableName="client_api_keys">
            <column name="api_key" value="OThiNGJkNzEtMTZjMy00YTMzLThjN2QtZDM1N2JmMTJhNzIx"/>
            <column name="revoked" valueBoolean="true"/>
        </insert>
    </changeSet>

    <changeSet id="create.table.weather_cache" author="developer">
        <createTable tableName="weather_cache">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="latitude" type="double">
                <constraints nullable="false"/>
            </column>
            <column name="longitude" type="double">
                <constraints nullable="false"/>
            </column>
            <column name="temperature" type="double">
                <constraints nullable="false"/>
            </column>
            <column name="temperature_unit" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="wind_speed" type="double">
                <constraints nullable="false"/>
            </column>
            <column name="wind_direction" type="double">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_weather_cache_location" tableName="weather_cache">
            <column name="latitude"/>
            <column name="longitude"/>
        </createIndex>

        <createIndex indexName="idx_weather_cache_created_at" tableName="weather_cache">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
